<?xml version="1.0" encoding="utf-8"?>
<!--
    API 30 and earlier, where android:allowBackup="false" already turns backup off.
    Every domain is excluded as well, so the same guarantee holds if that flag ever changes.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
