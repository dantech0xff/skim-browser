<resources>
    <!--
        The icons in res/drawable are copied unchanged from the design handoff and tint with
        ?attr/colorControlNormal, an AppCompat attribute. Skim has no AppCompat, so the attribute is
        declared here (same format as AppCompat's) and mapped to the platform control color.
    -->
    <attr name="colorControlNormal" format="color" />

    <!-- Compose draws every screen edge to edge; the window theme only sets the background shown before the first frame. -->
    <style name="Theme.SkimBrowser" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/skim_window_light</item>
        <item name="colorControlNormal">?android:attr/colorControlNormal</item>
    </style>
</resources>
