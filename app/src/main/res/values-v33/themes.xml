<resources>
    <!--
        From API 33 a start that is not from the launcher omits the splash icon unless this
        platform attribute is set. The compat library does not forward it. Night uses
        values-night-v33: UI mode outranks the API qualifier, so this file is day only.
    -->
    <style name="Theme.SkimBrowser.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/skim_window_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.SkimBrowser</item>
        <item name="android:windowSplashScreenBehavior">icon_preferred</item>
    </style>
</resources>
